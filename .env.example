# Shared secret required on every /api/* request (dashboard, Chrome extension,
# Android widget all send it). Generate one with: openssl rand -hex 32
NEXT_PUBLIC_API_SHARED_SECRET=

# Upstash Redis (production storage — falls back to data/db.json locally if unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Calendar push (optional — daily cron skips this if unset, everything else
# still works). NOT YET VERIFIED against a real Google Cloud project. See
# lib/calendar/googleAuth.ts for how to obtain a refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
